{
  "name": "@chatwith/game-night",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Open-source party games for your TV, with phones as controllers.",
  "scripts": {
    "dev": "node server/index.js --dev",
    "build": "vite build",
    "start": "node server/index.js",
    "play": "node scripts/play.mjs",
    "setup": "npm ci && npm run build",
    "test": "node --test tests/*.test.js",
    "test:browser": "python tests/browser.py",
    "test:package": "python -m unittest discover -s tests -p packaging_test.py",
    "check": "npm run build && npm test",
    "package": "python scripts/package-release.py"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "express": "5.3.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "vite": "8.3.5"
  },
  "license": "MIT",
  "author": "ChatWith",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChatWith-Technologies/game-night.git"
  },
  "homepage": "https://github.com/ChatWith-Technologies/game-night",
  "bugs": {
    "url": "https://github.com/ChatWith-Technologies/game-night/issues"
  }
}
